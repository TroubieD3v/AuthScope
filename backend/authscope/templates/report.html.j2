<!doctype html>
<html lang="en" class="dark"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AuthScope report - {{ d.project }}</title>
<style>
 :root{--bg:#eef0f2;--panel:#f8f9fa;--panel2:#e8ebee;--line:#cdd3d9;--line2:#e1e5e9;--text:#1e2227;--mute:#5b626a;--bad:#a8402f;--warn:#87601a;--ok:#3b6a4a;--acc:#2c5d8a;--code:#f8f9fa}
 .dark{--bg:#191b1e;--panel:#1f2226;--panel2:#24272c;--line:#2f333a;--line2:#25282d;--text:#d5d7da;--mute:#8d939a;--bad:#d98577;--warn:#d0a866;--ok:#94b08e;--acc:#8fb4d8;--code:#191b1e}
 *{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--text);font:13px/1.5 'IBM Plex Sans',system-ui,'Segoe UI',sans-serif;-webkit-font-smoothing:antialiased;font-feature-settings:"tnum"}
 main{max-width:1080px;margin:0 auto;padding:28px 24px 64px}
 h1,h2,h3{font-family:'IBM Plex Sans',system-ui,'Segoe UI',sans-serif;font-weight:600;letter-spacing:0}
 h1{font-size:20px;line-height:1.2;margin:10px 0 4px} h2{font-size:14px;margin:32px 0 10px}
 .top{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;padding-bottom:10px;border-bottom:1px solid var(--line)}
 .brand{display:flex;align-items:center;gap:8px;font:600 13px 'IBM Plex Sans',system-ui,'Segoe UI',sans-serif}
 .mark{width:18px;height:18px;color:var(--acc);display:grid;place-items:center;font-size:13px}
 .toggle{cursor:pointer;border:1px solid var(--line);background:var(--panel);color:var(--text);padding:4px 10px;font:500 12px 'IBM Plex Sans',system-ui,'Segoe UI',sans-serif}
 .mute{color:var(--mute)}
 .pill{display:inline-block;padding:0 6px;line-height:18px;font-size:11px;font-weight:500;border:1px solid var(--line);color:var(--mute);margin-right:4px}
 .pill.violation,.pill.bad{border-color:color-mix(in srgb,var(--bad) 40%,transparent);background:color-mix(in srgb,var(--bad) 12%,transparent);color:var(--bad)}
 .pill.needs_review,.pill.warn{border-color:color-mix(in srgb,var(--warn) 40%,transparent);background:color-mix(in srgb,var(--warn) 12%,transparent);color:var(--warn)}
 .pill.ok{border-color:color-mix(in srgb,var(--ok) 40%,transparent);background:color-mix(in srgb,var(--ok) 10%,transparent);color:var(--ok)}
 .cards{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin:16px 0}
 .card{background:var(--panel);padding:8px 12px}
 .card .lbl{font-size:12px;color:var(--mute)}
 .card .num{display:block;font:500 20px 'IBM Plex Mono',ui-monospace,'Cascadia Mono',Consolas,monospace;margin-top:2px}
 .finding{background:var(--panel);border:1px solid var(--line);padding:12px 14px;margin:10px 0}
 .finding.violation{box-shadow:inset 3px 0 0 var(--bad)} .finding.needs_review{box-shadow:inset 3px 0 0 var(--warn)}
 .finding h3{margin:6px 0 2px;font:500 13px 'IBM Plex Mono',ui-monospace,'Cascadia Mono',Consolas,monospace}
 pre{background:var(--code);border:1px solid var(--line);padding:8px 10px;overflow:auto;font:12px/1.55 'IBM Plex Mono',ui-monospace,'Cascadia Mono',Consolas,monospace;white-space:pre-wrap;word-break:break-word}
 .xlbl{font-size:12px;color:var(--mute);margin:12px 0 4px}
 table{border-collapse:collapse;width:100%;background:var(--panel);border:1px solid var(--line)} td,th{border-bottom:1px solid var(--line2);padding:5px 10px;text-align:left;vertical-align:top}
 th{font-size:12px;font-weight:500;color:var(--mute);background:var(--panel2);border-bottom-color:var(--line)}
 details{margin:8px 0} summary{cursor:pointer;color:var(--mute);font-weight:500}
 .cols{display:grid;grid-template-columns:1fr 1fr;gap:10px}@media(max-width:800px){.cols,.cards{grid-template-columns:1fr 1fr}}
 code{font-family:'IBM Plex Mono',ui-monospace,'Cascadia Mono',Consolas,monospace}
</style></head><body><main>
<div class="top"><div class="brand"><div class="mark">&#x2713;</div>AuthScope</div>
<button class="toggle" onclick="document.documentElement.classList.toggle('dark')">Light / dark</button></div>
{% set v = d.summary.verdicts %}
<span class="pill {{ 'bad' if v.get('violation',0) else 'ok' }}">{{ 'Action needed' if v.get('violation',0) else 'Policy holds' }}</span>
<h1>Authorization report</h1>
<div class="mute">{{ d.project }} &middot; target <code>{{ d.target }}</code> &middot; run <code>{{ d.run.id }}</code> ({{ d.run.status }}) &middot; {{ d.run.started_at }}</div>
<p class="mute">Tokens and sensitive values are masked. Reproduction commands read tokens from environment variables.</p>
{% for w in d.warnings %}<p style="color:var(--warn)">Warning: {{ w }}</p>{% endfor %}
<div class="cards">
 <div class="card"><span class="lbl">Violations</span><span class="num" style="color:var(--bad)">{{ v.get('violation',0) }}</span></div>
 <div class="card"><span class="lbl">Need review</span><span class="num" style="color:var(--warn)">{{ v.get('needs_review',0) }}</span></div>
 <div class="card"><span class="lbl">Passed</span><span class="num" style="color:var(--ok)">{{ v.get('pass',0) }}</span></div>
 <div class="card"><span class="lbl">Inconclusive / skipped</span><span class="num">{{ v.get('inconclusive',0) + v.get('skipped',0) + v.get('error',0) }}</span></div>
</div>
<h2>Findings ({{ findings|length }})</h2>
{% if not findings %}<p>No violations or review items were found.</p>{% endif %}
{% for r in findings %}
<div class="finding {{ r.verdict }}">
 <span class="pill {{ r.verdict }}">{{ labels[r.verdict] }}</span><span class="pill {{ 'bad' if r.severity in ('critical','high') else 'warn' if r.severity == 'medium' else '' }}">{{ r.severity }}</span><span class="pill">{{ r.module }}</span>
 <h3>{{ r.name }}</h3>
 <div class="mute">id {{ r.id }} &middot; {{ r.endpoint_key }}{% if r.resource %} &middot; {{ r.resource }}{% endif %}</div>
 <p>{{ r.message }}</p>
 {% if r.evidence %}
  <div class="xlbl">Expected policy</div><div>{{ r.evidence.expected }}</div>
  {% if r.evidence.diff %}<div class="xlbl">Analysis</div><ul>{% for line in r.evidence.diff %}<li>{{ line }}</li>{% endfor %}</ul>{% endif %}
  <div class="cols">
   {% for title, ex in (('Baseline', r.evidence.baseline), ('Test', r.evidence.test)) %}{% if ex %}
   <div><div class="xlbl">{{ title }} &middot; {{ ex.identity or 'anonymous' }}</div>
    <pre>{{ ex.method }} {{ ex.url }}{% for k, val in ex.request_headers.items() %}
{{ k }}: {{ val }}{% endfor %}{% if ex.request_body %}

{{ ex.request_body }}{% endif %}</pre>
    <pre>{% if ex.status is not none %}HTTP {{ ex.status }}{% else %}ERROR {{ ex.error }}{% endif %}
{{ ex.response_body or '' }}</pre></div>
   {% endif %}{% endfor %}
  </div>
  {% if r.evidence.reproduction %}<details><summary>Reproduce</summary><pre>{{ r.evidence.reproduction|join('\n\n') }}</pre></details>{% endif %}
 {% endif %}
</div>
{% endfor %}
<h2>Passed checks ({{ passed|length }})</h2>
<table><tr><th>Module</th><th>Check</th><th>Result</th></tr>
{% for r in passed %}<tr><td>{{ r.module }}</td><td>{{ r.name }}</td><td class="mute">{{ r.message }}</td></tr>{% endfor %}</table>
{% if rest %}<h2>Inconclusive, skipped and errors ({{ rest|length }})</h2>
<table><tr><th>Verdict</th><th>Check</th><th>Reason</th></tr>
{% for r in rest %}<tr><td>{{ r.verdict }}</td><td>{{ r.name }}</td><td class="mute">{{ r.message }}</td></tr>{% endfor %}</table>{% endif %}
</main></body></html>
